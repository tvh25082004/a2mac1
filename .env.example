# A2MAC1 IBP crawler configuration
# Full cookie string from the browser (F12 -> Network -> request headers -> cookie:),
# must contain access_token=eyJ... (JWT, valid ~24 minutes)
A2MAC1_TOKEN='<paste full cookie string here>'
# Delay between requests in seconds (anti-403 throttle)
A2MAC1_DELAY=0.25
# Optional: GitHub PAT with repo scope, used by gh_release_upload.py for Release uploads
GH_PAT='<github personal access token>'
